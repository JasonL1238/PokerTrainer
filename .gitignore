__pycache__/
.pytest_cache/
.venv/
.env
CLAUDE.local.md
deploy/oci/.env
*.pyc
poker_tracker.db
poker_tracker.db-*
output/
tmp/
artifacts/ui-review/

# Tool caches / local config
.mpl_config/
.yolo_config/
.claude/settings.local.json

# Labeling tool local data (labels DB + captured images)
cv_lab/labeling_poker/data/

# CV research data & artifacts (code lives in cv_lab/scripts and cv_lab/notes)
cv_lab/crops/
cv_lab/datasets/
cv_lab/frames/
cv_lab/hand01/
cv_lab/harvest/
# (pattern is `dir/*`, not `dir/`, so the negation below is reachable -- git
# never descends into a directory excluded as a whole)
cv_lab/models/*
# EXCEPT the OCR template bank. It is 21 KB of averaged glyph vectors, not a
# regenerable-from-the-repo artifact: rebuilding it needs the source recordings.
# While it was ignored, 8 of the 9 real-crop OCR regression tests skipped on any
# clean checkout, in CI and in the Docker build -- so every decimal / truncation
# defect they pin was unprotected everywhere except the calibrating machine.
!cv_lab/models/ocr_templates.npz
cv_lab/results/
cv_lab/runs/
cv_lab/logs/
runs/

# Training/run logs and downloaded model weights (regenerable / re-downloadable)
*.log
*.pt

# Auto-generated labeling priority list (regenerate from labels.sqlite3)
cv_lab/labeling_poker/priority/
data/*
!data/.gitkeep
!data/videos/
data/videos/*
!data/videos/.gitkeep
!data/frames/
data/frames/*
!data/frames/.gitkeep
!data/exports/
data/exports/*
!data/exports/.gitkeep
!data/roi_previews/
data/roi_previews/*
!data/roi_previews/.gitkeep
