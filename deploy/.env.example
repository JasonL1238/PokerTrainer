# Copy to .env in the repository root before `docker compose up`. Never commit .env.

# Required when POKERTRAINER_REQUIRE_AUTH is true, which it is in the image.
APP_PASSWORD=replace-with-a-long-random-password

# Host and container port. Changing it here changes both.
PORT=8501

# bundled | none. "none" builds and ships no TexasSolver.
SOLVER_VARIANT=bundled

# Solver resource ceilings, applied to the console_solver child process.
POKERTRAINER_SOLVER_THREADS=2
POKERTRAINER_SOLVER_MEMORY_GB=8

# Refuse to start when the CV weights under /data/models are missing or do not
# match deploy/model_manifest.json. Leave unset to start anyway with video
# reconstruction unavailable and every other feature working.
# POKERTRAINER_REQUIRE_MODELS=true

# Coaching providers. Leave blank to run without a model provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
